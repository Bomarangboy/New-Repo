# Bluewater Collective — configuration template.
# Copy to `.env.local` for your computer. NEVER commit real values.
# Hosted environments (Vercel) get these from the Vercel dashboard → Settings → Environment Variables.

# development | test | staging | demo | production
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Database (PostgreSQL / Supabase) ---------------------------------------
# App connection: the restricted `bluewater_app` role (cannot bypass row-level security).
# On Supabase use the *transaction pooler* connection string (port 6543) with user bluewater_app.<project-ref>.
DATABASE_URL=postgres://bluewater_app:bluewater_app_local@localhost:5432/bluewater_dev
# Owner connection, used ONLY to run migrations (npm run db:migrate). Not needed by the running app.
DATABASE_MIGRATION_URL=postgres://bluewater_owner:bluewater_owner_local@localhost:5432/bluewater_dev
# Set once per hosted environment when running migrations, so the app role gets its password.
# APP_DB_ROLE_PASSWORD=

# --- Sign-in -----------------------------------------------------------------
# local    = development/test only (refuses to run anywhere else)
# supabase = staging, demo, production
AUTH_PROVIDER=local
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (safe for browsers)
# SUPABASE_SECRET_KEY=sb_secret_...                          (SERVER ONLY — never NEXT_PUBLIC_)

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT key for every environment. Losing it makes stored MFA secrets/integration tokens unreadable.
ENCRYPTION_KEY=

# --- Bluewater's own service emails (invitations, password resets) -------------
# dev-outbox = shown at /dev/mailbox, nothing is sent. postmark = real email (staging/production only).
SYSTEM_EMAIL_TRANSPORT=dev-outbox
SYSTEM_EMAIL_FROM="Bluewater Collective <no-reply@example.invalid>"
# POSTMARK_SERVER_TOKEN=

# --- Client messaging master switch ------------------------------------------
# Must stay false until the owner approves go-live. Refused in development, test and demo.
LIVE_SENDING_ENABLED=false

# Secret the every-minute scheduler (Supabase Cron) presents to POST /api/jobs/run. 24+ random characters,
# different per environment. Not needed locally: use `npm run jobs:work` instead.
# JOB_TRIGGER_SECRET=

# --- Advertising platforms (Stage 5) ------------------------------------------
# Live Meta/Google connections stay OFF until the owner approves and the platforms approve Bluewater's apps.
# Refused in development, test and the demo (those always use simulated accounts). See docs/ADS.md.
ADS_LIVE_ENABLED=false
# META_APP_ID=
# META_APP_SECRET=                 (SERVER ONLY — also verifies Meta's webhook signatures)
# META_WEBHOOK_VERIFY_TOKEN=       (any long random string; entered once in Meta's webhook settings)
# META_GRAPH_VERSION=v26.0
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=    (10 digits, only if clients are linked under Bluewater's manager account)
# GOOGLE_ADS_API_VERSION=v25

# ---- Platform Studio (appearance editor) ----
# Recovery switch: set to true and redeploy to ignore every Studio setting and show the built-in Bluewater look
# (use if a published layout ever makes the admin area hard to use). See docs/STUDIO.md.
STUDIO_SAFE_MODE=false
